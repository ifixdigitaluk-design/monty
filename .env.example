# Copy to .env and adjust. Never commit real secrets.
# The API connects as the restricted runtime role (row-level security applies to it).
DATABASE_URL=postgresql://monty_app:monty_app_dev@localhost:5432/monty_dev
# Migrations connect as the schema owner.
MIGRATION_DATABASE_URL=postgresql://monty:monty_dev@localhost:5432/monty_dev
# Tests: owner URL for fixtures, app-role URL for the API under test.
TEST_DATABASE_URL=postgresql://monty:monty_dev@localhost:5432/monty_test
TEST_APP_DATABASE_URL=postgresql://monty_app:monty_app_dev@localhost:5432/monty_test
# true = refuse to start unless RLS is effective (always on in production)
REQUIRE_RLS=true
API_PORT=4000
ALLOWED_ORIGINS=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
LOG_LEVEL=info
NODE_ENV=development
# Public web origin used in email links
APP_URL=http://localhost:3000
# log = keep emails in memory (dev mailbox at /api/v1/dev/mailbox); smtp = real provider
MAIL_TRANSPORT=log
MAIL_FROM=Monty <no-reply@localhost>
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
