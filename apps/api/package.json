{
  "name": "@monty/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch --env-file-if-exists=../../.env dist/main.js",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@monty/database": "workspace:*",
    "@monty/domain": "workspace:*",
    "@monty/validation": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.4",
    "helmet": "8.3.0",
    "nodemailer": "10.1.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@swc/core": "1.16.20",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "pg": "8.23.1",
    "supertest": "7.3.1",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
  }
}
