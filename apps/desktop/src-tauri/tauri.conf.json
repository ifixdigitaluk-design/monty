{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monty",
  "version": "0.1.0",
  "identifier": "app.monty.desktop",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [],
    "security": { "csp": "default-src 'self'; style-src 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "dmg", "app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "Plan, organise and deliver projects"
  }
}
