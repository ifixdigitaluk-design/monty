# Copy to infra/docker/.env (git-ignored) and fill in. Never commit real values.
POSTGRES_PASSWORD=
MONTY_APP_DB_PASSWORD=
# openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Public origin users browse to (https in production). The stack itself only listens on 127.0.0.1.
APP_URL=https://monty.localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Monty <no-reply@example.com>
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=
# Bearer token required to read /api/v1/metrics (leave empty to disable the endpoint)
METRICS_TOKEN=
# Optional: receives a JSON POST for every unhandled server error (e.g. an error tracker's webhook intake)
ERROR_WEBHOOK_URL=
