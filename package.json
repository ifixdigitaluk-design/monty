{
  "name": "monty",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "build:packages": "pnpm -r --filter \"./packages/*\" run build",
    "dev": "pnpm build:packages && pnpm -r --parallel --filter @monty/api --filter @monty/web run dev",
    "start": "pnpm -r --parallel --filter @monty/api --filter @monty/web run start",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "e2e": "pnpm --filter @monty/e2e run e2e",
    "db:migrate": "pnpm --filter @monty/database run migrate",
    "db:generate": "pnpm --filter @monty/database run generate"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
